# Copy to .env and enter your own credentials. Never commit .env.
DB_URL=jdbc:mysql://localhost:3306/swifttray
DB_USERNAME=swifttray
DB_PASSWORD=

# Set these for the first run to create the administrator.
# Remove the password after the administrator has been created.
SWIFTTRAY_ADMIN_EMAIL=
SWIFTTRAY_ADMIN_PASSWORD=

# false for local HTTP; true behind production HTTPS.
COOKIE_SECURE=false
